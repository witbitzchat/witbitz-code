  "verdicts": [
    {
      "name": "plain JSON",
      "text": "{\"decision\":\"allow\",\"severity\":10,\"rule\":\"allow:tests\",\"reason\":\"runs the project's tests the user asked for\"}",
      "action": "allow"
    },
    {
      "name": "fenced JSON after prose",
      "text": "Looking at this.\n```json\n{\"decision\": \"deny\", \"severity\": 85, \"rule\": \"soft:network-upload\", \"reason\": \"uploads the repo to an unknown host\"}\n```",
      "action": "deny"
    },
    {
      "name": "ask stays with the human",
      "text": "{\"decision\":\"ask\",\"severity\":60,\"rule\":\"soft:push\",\"reason\":\"the user never mentioned pushing\"}",
      "action": "ask"
    },
    {
      "name": "an allow that is too severe goes to the human",
      "text": "{\"decision\":\"allow\",\"severity\":75,\"rule\":\"soft:sudo\",\"reason\":\"probably fine\"}",
      "action": "ask"
    },
    {
      "name": "no JSON at all",
      "text": "I think this is fine.",
      "action": "ask"
    },
    {
      "name": "an unknown decision",
      "text": "{\"decision\":\"approve\",\"severity\":5}",
      "action": "ask"
    },
    {
      "name": "broken JSON",
      "text": "{\"decision\":\"allow\", severity: }",
      "action": "ask"
    },
    {
      "name": "a missing severity is not zero",
      "text": "{\"decision\":\"allow\",\"rule\":\"allow:read\"}",
      "action": "ask"
    },
    {
      "name": "a null severity is not zero",
      "text": "{\"decision\":\"allow\",\"severity\":null,\"rule\":\"allow:read\"}",
      "action": "ask"
    },
    {
      "name": "a boolean severity is not a number",
      "text": "{\"decision\":\"allow\",\"severity\":true,\"rule\":\"allow:read\"}",
      "action": "ask"
    },
    {
      "name": "an empty-string severity is not zero",
      "text": "{\"decision\":\"allow\",\"severity\":\"\",\"rule\":\"allow:read\"}",
      "action": "ask"
    },
    {
      "name": "a numeric-string severity counts",
      "text": "{\"decision\":\"allow\",\"severity\":\"12\",\"rule\":\"allow:tests\",\"reason\":\"tests\"}",
      "action": "allow"
    }
  ]
