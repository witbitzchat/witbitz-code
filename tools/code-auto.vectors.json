{
  "_about": "Shared cases for Code Auto mode (docs/code-auto-mode.md). tools/code-auto.test.mjs runs them against tools/code-auto.mjs; the Python twin must give the same answers. stage: hard-deny | fast-allow | review (the model decides).",
  "directory": "/home/u/repo",
  "home": "/home/u",
  "cases": [
    {
      "name": "rm -rf the filesystem root",
      "req": {
        "permission": "bash",
        "patterns": [
          "rm -rf /"
        ],
        "metadata": {
          "command": "rm -rf /"
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "rm -rf the home directory with ~",
      "req": {
        "permission": "bash",
        "patterns": [
          "rm -rf ~"
        ],
        "metadata": {
          "command": "rm -rf ~"
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "rm -rf $HOME hidden after a harmless command",
      "req": {
        "permission": "bash",
        "patterns": [
          "ls"
        ],
        "metadata": {
          "command": "ls && rm -fr \"$HOME\""
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "rm -rf of the home path spelled out",
      "req": {
        "permission": "bash",
        "patterns": [
          "rm -rf /home/u"
        ],
        "metadata": {
          "command": "rm -Rf /home/u/"
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "rm with --no-preserve-root",
      "req": {
        "permission": "bash",
        "patterns": [
          "rm"
        ],
        "metadata": {
          "command": "rm -r --no-preserve-root /"
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "mkfs on a device",
      "req": {
        "permission": "bash",
        "patterns": [
          "mkfs"
        ],
        "metadata": {
          "command": "sudo mkfs.ext4 /dev/sda1"
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "dd onto a device",
      "req": {
        "permission": "bash",
        "patterns": [
          "dd"
        ],
        "metadata": {
          "command": "dd if=/dev/zero of=/dev/nvme0n1 bs=1M"
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "fork bomb",
      "req": {
        "permission": "bash",
        "patterns": [
          ":(){"
        ],
        "metadata": {
          "command": ":(){ :|:& };:"
        }
      },
      "stage": "hard-deny"
    },
    {
      "name": "rm -rf a build directory is NOT a hard deny — the model judges it",
